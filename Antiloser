local function visPlace(vp, name)
    if not vp or not name then return false end
    if not Vis.had or tick() > Vis.untilT then return false end
    local already
    pcall(function() already = vp:GetAttribute("VenomVisualName") end)
    if already == name then
        for _, c in ipairs(vp:GetChildren()) do
            if c:IsA("WorldModel") or c:IsA("Model") then return true end
        end
    end
    local pose = { rot = nil, camCF = nil, center = nil, hasReal = false }
    local function sample(v)
        if not v then return false end
        local tagged
        pcall(function() tagged = v:GetAttribute("VenomVisualName") end)
        if tagged and tagged ~= "" then return false end
        for _, c in ipairs(v:GetChildren()) do
            local m = c:IsA("Model") and c or (c:IsA("WorldModel") and c:FindFirstChildWhichIsA("Model"))
            if m then
                local piv = m:GetPivot()
                pose.rot = piv - piv.Position
                pose.center = m:GetBoundingBox().Position
                if v.CurrentCamera then pose.camCF = v.CurrentCamera.CFrame end
                pose.hasReal = true
                return true
            end
        end
        return false
    end
    pcall(function()
        if not sample(vp) then
            local sec = visSections()
            if sec then
                for _, side in ipairs({ sec.other, sec.main }) do
                    local b = side and visBundle(side)
                    if b and b.viewport and sample(b.viewport) then break end
                end
            end
        end
    end)
    for _, c in ipairs(vp:GetChildren()) do pcall(function() c:Destroy() end) end
    local model = visModel(name)
    if not model then return false end
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Anchored = true
            part.CastShadow = false
        end
    end
    local wm = Instance.new("WorldModel")
    wm.Parent = vp
    model.Parent = wm

    local cf, size = CFrame.new(), Vector3.new(2, 2, 2)
    pcall(function() cf, size = model:GetBoundingBox() end)
    local center = cf.Position
    if pose.hasReal and pose.rot then
        pcall(function() model:PivotTo(CFrame.new(center) * pose.rot) end)
    else
        pcall(function() model:PivotTo(CFrame.new(center)) end)
    end
    pcall(function() cf, size = model:GetBoundingBox() end)
    center = cf.Position

    local cam = Instance.new("Camera")
    cam.Parent = vp
    vp.CurrentCamera = cam

    local maxS = math.max(size.X, size.Y, size.Z, 1)
    local camPos
    if pose.hasReal and pose.camCF and pose.center then
        camPos = center + (pose.camCF.Position - pose.center)
    else
        camPos = center + Vector3.new(0, maxS * 0.25, math.clamp(maxS * 0.95, 1.6, 12))
    end

    pcall(function()
        local piv = model:GetPivot()
        local toCam = camPos - piv.Position
        local flat = Vector3.new(toCam.X, 0, toCam.Z)
        if flat.Magnitude > 0.05 then
            flat = flat.Unit
            local look = Vector3.new(piv.LookVector.X, 0, piv.LookVector.Z)
            if look.Magnitude > 0.05 then
                look = look.Unit
                -- brainrot assets face opposite of LookVector in these viewports
                model:PivotTo(piv * CFrame.Angles(0, math.pi + math.rad(-32), 0))
            end
        end
    end)
    pcall(function() cf, size = model:GetBoundingBox() end)
    center = cf.Position
    if pose.hasReal and pose.camCF and pose.center then
        local off = pose.camCF.Position - pose.center
        local rotOnly = pose.camCF - pose.camCF.Position
        cam.CFrame = CFrame.new(center + off) * rotOnly
    else
        local dist = math.clamp(math.max(size.X, size.Y, size.Z) * 0.95, 1.6, 12)
        cam.CFrame = CFrame.new(center + Vector3.new(0, maxS * 0.25, dist), center)
    end
    pcall(function() vp:SetAttribute("VenomVisualName", name) end)
    task.spawn(function()
        task.wait(0.05)
        pcall(function()
            local ac = model:FindFirstChildOfClass("AnimationController") or Instance.new("AnimationController")
            ac.Parent = model
            local an = ac:FindFirstChildOfClass("Animator") or Instance.new("Animator")
            an.Parent = ac
            local root = game:GetService("ReplicatedStorage"):FindFirstChild("Animations")
            local folder = root and root:FindFirstChild("Animals") and root.Animals:FindFirstChild(name)
            local idle = folder and (folder:FindFirstChild("Idle") or folder:FindFirstChildWhichIsA("Animation"))
            if idle then
                local tr = an:LoadAnimation(idle)
                tr.Looped = true
                tr:Play()
            end
        end)
    end)
    return true
end

