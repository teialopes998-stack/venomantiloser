local function visApply(list)
    list = type(list) == "table" and list or {}
    if #list > 0 and (not Vis.had or tick() > Vis.untilT) then
        Vis.pending = nil
        return
    end
    local parts = {}
    for _, e in ipairs(list) do parts[#parts + 1] = tostring(e.name or "") end
    local sig = table.concat(parts, ";")
    if #list == 0 then
        local sec = visSections()
        if sec then
            if sec.other then local b = visBundle(sec.other) if b then visClear(b.viewport) end end
            if sec.main then local b = visBundle(sec.main) if b then visClear(b.viewport) end end
        end
        Vis.pending, Vis.sig, Vis.had, Vis.untilT = nil, "", false, 0
        return
    end
    if sig == Vis.sig and Vis.had then return end
    local sec = visSections()
    if not sec then
        if tick() <= Vis.untilT then
            Vis.pending = list
            task.spawn(function()
                for _ = 1, 15 do
                    task.wait(0.4)
                    if tick() > Vis.untilT or not Vis.pending then return end
                    if visSections() then visApply(Vis.pending) return end
                end
            end)
        end
        return
    end
    local e = list[1]
    local applied = false
    if sec.other then applied = visApplyOne(visBundle(sec.other), e) or applied end
    if not applied and sec.main then applied = visApplyOne(visBundle(sec.main), e) or applied end
    if applied then Vis.sig, Vis.had, Vis.pending = sig, true, list end
end

