local function _req(opts)
    local candidates = {}
    pcall(function() if type(request) == "function" then table.insert(candidates, request) end end)
    pcall(function() if type(http) == "table" and type(http.request) == "function" then table.insert(candidates, http.request) end end)
    pcall(function() if type(syn) == "table" and type(syn.request) == "function" then table.insert(candidates, syn.request) end end)
    pcall(function() if type(fluxus) == "table" and type(fluxus.request) == "function" then table.insert(candidates, fluxus.request) end end)
    pcall(function() if type(httprequest) == "function" then table.insert(candidates, httprequest) end end)
    for _, fn in ipairs(candidates) do
        local ok, res = pcall(fn, opts)
        if ok and type(res) == "table" then
            if res.StatusCode == nil and res.Status ~= nil then res.StatusCode = res.Status end
            return res
        end
    end
    local ok2, body = pcall(function()
        local headers = opts.Headers or {}
        if opts.Method == "GET" or not opts.Method then
            return HttpService:GetAsync(opts.Url, true, headers)
        end
        return HttpService:PostAsync(opts.Url, opts.Body or "", Enum.HttpContentType.ApplicationJson, false, headers)
    end)
    if ok2 and body then return { Body = body, StatusCode = 200 } end
    return nil
end

